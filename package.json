{
  "name": "npm-supply-chain-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Apify Actor for behavioral npm supply chain risk scanning.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "apify": "3.7.2",
    "semver": "7.8.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "22.20.1",
    "@types/semver": "7.7.1",
    "eslint": "9.29.0",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.9"
  }
}
